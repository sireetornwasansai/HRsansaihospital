  if (!cid) return lineReply_(ev.replyToken, [helpMsg_('ยังไม่ได้เชื่อมต่อบัญชี กรุณาเปิดเว็บ → ติดตามสถานะ → "เชื่อมต่อ LINE" เพื่อรับรหัส หรือพิมพ์เลขบัตรประชาชน 13 หลักในแชทนี้')]);
