  if (a.length < 2 || a.length > 3000) throw new Error('คำตอบต้องไม่ว่างและไม่เกิน 3,000 ตัวอักษร');
  if (cat.length > 40) throw new Error('ชื่อหมวดยาวเกิน 40 ตัวอักษร');
