function apiSubmit_(p) {
  p = p || {};
  var f = {};
  ['prefix', 'first', 'last', 'position', 'group', 'posNo', 'start', 'edu', 'link', 'phone', 'email'].forEach(function (k) { f[k] = str_(p[k]); });
  f.title = str_(p.title).replace(/\s+/g, ' ');
  f.cid = digits_(p.cid);
  ['prefix', 'first', 'last', 'position', 'group', 'edu'].forEach(function (k) { if (!f[k]) throw new Error('กรุณากรอกข้อมูลให้ครบถ้วน'); });
  if (!f.title) throw new Error('กรุณากรอกชื่อผลงาน');
  if (f.title.length > TITLE_MAX) throw new Error('ชื่อผลงานยาวเกินไป (ไม่เกิน ' + TITLE_MAX + ' ตัวอักษร)');
  if (!validCid_(f.cid)) throw new Error('เลขบัตรประชาชนไม่ถูกต้อง');
  f.track = trackNorm_(p.track);
  if (!f.track) throw new Error('กรุณาเลือกระดับตำแหน่งที่ขอเลื่อน');
  if (f.email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(f.email)) throw new Error('รูปแบบอีเมลไม่ถูกต้อง');
  if (f.link && !/^https?:\/\//i.test(f.link)) throw new Error('ลิงก์ต้องขึ้นต้นด้วย http:// หรือ https://');
  if (!(p.file && p.file.data) && !f.link) throw new Error('กรุณาแนบไฟล์หรือใส่ลิงก์ผลงาน');
  var up = (p.file && p.file.data) ? saveUpload_(p.file, SUBMIT_EXT, false) : null;   // ตรวจไฟล์ก่อนเข้าล็อก
  var lock = LockService.getScriptLock();
  lock.waitLock(15000);
  var id, it;
  try {
    if (up) f.link = up.url;
    var sh = sheet_('SUB'), n = sh.getLastRow(); var taken = {}; subs_().forEach(function (r) { taken[r.id] = 1; }); usedIds_(taken); var day = Utilities.formatDate(new Date(), TZ, 'yyyyMMdd'); do { id = 'AWC-' + day + '-' + ('000' + n).slice(-4); n++; } while (taken[id]);   // กัน รหัสซ้ำเมื่อมีการลบแถว
    var t = now_();
    appendText_(sh, [id, t, f.prefix, f.first, f.last, f.cid, f.position, f.group, f.posNo, f.start, tenure_(f.start), f.edu, f.title, f.link, f.phone, f.email, 'b1_submit', '', t, f.track]);
    appendText_(sheet_('HIS'), [id, t, 'b1_submit', 'ยื่นเอกสาร', f.first + ' ' + f.last]);
    it = { id: id, cid: f.cid, email: f.email, prefix: f.prefix, first: f.first, last: f.last, title: f.title, status: 'b1_submit', note: '' };
    notify_(it, 'ความคืบหน้าปัจจุบันของเลขที่เอกสาร ' + id + ' คือ "' + stageLabel_(it) + '"', 'received');
    log_('submit', f.first, 'success', id);
  } finally { lock.releaseLock(); }
  var line = autoNotify_(it, f.first + ' ' + f.last, 'ยื่นเอกสารแล้ว', null);
  return { id: id, line: { sent: line.sent || 0 } };
}

