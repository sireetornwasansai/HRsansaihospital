function faqRows_() {
  var s = sheet_('FAQ'), n = s.getLastRow(); if (n < 2) return [];
  return s.getRange(2, 1, n - 1, 11).getValues().map(function (r, i) {
    return { row: i + 2, id: str_(r[0]), cat: str_(r[1]), q: str_(r[2]), a: String(r[3] == null ? '' : r[3]).replace(/\r/g, '').trim(), pub: str_(r[4]) !== 'N', pin: str_(r[5]) === 'Y', ord: +r[6] || 0, up: +r[7] || 0, down: +r[8] || 0, upd: str_(r[9]), by: str_(r[10]) };
  });
}
/* ใส่คำถามตั้งต้นครั้งเดียวเมื่อแท็บยังว่าง (เจ้าหน้าที่แก้ไข/ลบได้ในแท็บ "คำถามที่พบบ่อย" ของหน้าจัดการ) */
function faqSeed_() {
  var s = sheet_('FAQ'); if (s.getLastRow() > 1 || prop_('FAQ_SEEDED')) return;
  var t = now_(), rows = FAQ_SEED.map(function (f, i) { return ['FAQ-' + ('00' + (i + 1)).slice(-3), f[0], f[1], f[2], 'Y', f[3] ? 'Y' : 'N', (i + 1) * 10, 0, 0, t, 'ระบบ (ตั้งต้น)']; });
  s.getRange(2, 1, rows.length, 11).setValues(rows);
  PropertiesService.getScriptProperties().setProperty('FAQ_SEEDED', '1');
}
function faqPub_(r) { return { id: r.id, cat: r.cat, q: r.q, a: r.a, pin: r.pin, upd: r.upd }; }
function faqSort_(a, b) { return (b.pin ? 1 : 0) - (a.pin ? 1 : 0) || a.ord - b.ord || (a.id < b.id ? -1 : 1); }
/* สาธารณะ: เฉพาะรายการที่เผยแพร่ */
function apiFaqList_() {
  faqSeed_();
  var rows = faqRows_().filter(function (r) { return r.pub && r.q && r.a; }).sort(faqSort_);
  return { rows: rows.map(faqPub_), upd: rows.reduce(function (m, r) { return r.upd > m ? r.upd : m; }, '') };
}
function apiFaqVote_(id, helpful) {
