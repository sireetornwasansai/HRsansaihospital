/* เจ้าหน้าที่กด "ปิดเคส": บันทึกแบบประเมินของเจ้าหน้าที่ → สถานะ closing → ส่งให้ผู้ยื่นประเมิน */
function apiCloseRequest_(token, id, sv, note) {
