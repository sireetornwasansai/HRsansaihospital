/* สร้างผู้ใช้: อ้างอิงบุคลากรจาก allstaff (ต้องมีเลขบัตรในทะเบียน) แต่เก็บบัญชีในแท็บ Users แยกต่างหาก — ชื่อคัดลอกเป็นสำเนา การแก้ไขผู้ใช้ไม่กระทบ allstaff */
function apiUserAdd_(token, p) {
