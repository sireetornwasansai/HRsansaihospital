  var s = m[1] + '-' + m[2] + '-' + m[3] + ' ' + m[4] + ':' + m[5] + ':' + (m[6] || '00');
  var d = new Date(s.replace(' ', 'T') + '+07:00');
  if (isNaN(d.getTime()) || +m[2] < 1 || +m[2] > 12 || +m[3] < 1 || +m[3] > 31 || +m[4] > 23 || +m[5] > 59) throw new Error('วันที่/เวลาไม่ถูกต้อง');
  if (d.getTime() > Date.now() + 5 * 60000) throw new Error('ไม่สามารถลงเวลาล่วงหน้าในอนาคตได้');
