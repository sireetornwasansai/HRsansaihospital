    return { row: i + 2, id: str_(r[0]), t: str_(r[1]), role: str_(r[2]), who: str_(r[3]), exp: str_(r[4]), mode: str_(r[5]), q: q, avg: str_(r[22]), c: [str_(r[23]), str_(r[24]), str_(r[25])] };
