function gateOn_(track) { return trackNorm_(track) === GATE_TRACK; }
/* สถานะที่ "เริ่มนับ 180 วันส่งเล่ม 2" : เส้นทาง GATE_TRACK นับจาก b1_acting (HR อัพเดทสถานะคำสั่งรักษาการ) ; เส้นทางอื่นนับจาก b1_signed */
