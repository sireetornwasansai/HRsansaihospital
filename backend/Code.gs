      var at = now_();
      setText_(sh.getRange(r.row, col), to); setText_(sh.getRange(r.row, upd), at);
      appendText_(sheet_('HIS'), [r.id, at, to, 'ปรับสถานะตามขั้นตอนใหม่ (ยุบ "ลงนามแล้ว" เข้ากับขั้นตอนลงนาม) จาก ' + r.status, 'ระบบ']);
      moved.push(r.id + ': ' + r.status + ' → ' + to);
    });
  } finally { lock.releaseLock(); }
  log_('migrate_sign', 'script', 'success', moved.length + ' รายการ' + (moved.length ? ' — ' + moved.join(' ; ') : ''));
  return { moved: moved.length, items: moved };
}
function cleanOrphans() {
