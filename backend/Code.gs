  if (!validCid_(cid)) { lineReply_(ev.replyToken, [helpMsg_('เลขบัตรประชาชนไม่ถูกต้อง ตรวจสอบตัวเลขอีกครั้ง')]); return true; }
  var items = subs_().filter(function (r) { return r.cid === cid; });
