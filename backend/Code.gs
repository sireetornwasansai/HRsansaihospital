  } finally { lock.releaseLock(); }
  log_('delay_review', u.u, 'success', id + ' ' + k + ' #' + occ + ': ' + cs.join(',') + (note ? ' — ' + note : ''));
  return { id: id, k: k, occ: occ, rev: { causes: cs, note: note, by: by, at: at } };
}

