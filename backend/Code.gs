  var staff = staffByCid_(cid);
  if (!mine.length && !staff) { log_('track', '', 'not_found', ''); throw new Error('ไม่พบเลขบัตรประชาชนนี้ในระบบ'); }
  var his = sheet_('HIS'), hv = his.getLastRow() > 1 ? hisSort_(his.getRange(2, 1, his.getLastRow() - 1, 5).getValues()) : [];
  var qall = qaRows_(), aall = attRows_();
  var items = mine.map(function (r) {
    return {
      id: r.id, ts: r.ts, position: r.position, group: r.group, posNo: r.posNo, tenure: r.tenure, edu: r.edu, title: r.title, hasFile: !!r.link, qa: qthread_(qall, r.id),
      status: r.status, note: r.note, upd: r.upd, track: r.track, att: attPublic_(aall, r.id), fx: fixCount_(r.id),
      history: hv.filter(function (h) { return str_(h[0]) === r.id; }).map(function (h) { return { t: str_(h[1]), s: normKey_(str_(h[2])), n: str_(h[3]), by: str_(h[4]) }; })
    };
  }).reverse();
  var notes = lnlRows_().filter(function (n) { return n.cid === cid && OUT_TYPES.indexOf(n.type) > -1 && n.res !== 'skipped' && n.res !== 'no_line'; })
    .map(function (n) { return { t: n.t, id: n.id, type: n.type, m: n.m, fn: n.fn, fu: n.fu, ok: n.res === 'sent' }; }).reverse().slice(0, 40);
  var p = staff || mine[mine.length - 1] || {};
